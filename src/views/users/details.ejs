<%- include('../layout') %>

<div class="card" style="width: 18rem;">
  <img src="/images/default_profile_picture.jpg" class="card-img-top" alt="not available">
  <div class="card-body">
    <h5 class="card-title"><%= users.first_name %> <%= users.last_name %></h5>
  </div>

  <ul class="list-group list-group-flush">
    <li class="list-group-item">Email: <%= users.email %></li>
    <li class="list-group-item">Address: <%= users.address %></li>
    <li class="list-group-item">Active User: <%= users.active === 1 ? "Yes" : "No" %></li>
  </ul>

  <div class="card-body">
    <a href="/users/<%= users.customer_id %>/edit" class="btn btn-primary">Edit</a>
    <a href="/users" class="btn btn-warning">Cancel</a>
  </div>
</div>