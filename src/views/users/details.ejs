<%- include('../layout') %>

<div class="position-absolute top-50 start-50 translate-middle" style="max-width: 800px;">
  <div class="card" style="background-color: #bebebe;">
    <div class="row g-0">
      <div class="col-md-4">
        <img src="/images/default_profile_picture.jpg"
             class="img-fluid rounded-start p-2"
             alt="not available"
             style="height: 100%; object-fit: contain;">
      </div>
    <div class="col-md-8">
      <div class="card-body">
        <h5 class="card-title"><%= users.first_name %> <%= users.last_name %></h5>
  <ul class="list-group list-group-flush">
    <li class="list-group-item">Email: <%= users.email %></li>
    <li class="list-group-item">Address: <%= users.address %></li>
    <li class="list-group-item">Active User: <%= users.active === 1 ? "Yes" : "No" %></li>
  </ul>

  <div class="card-body">
    <a href="/users/<%= users.customer_id %>/edit" class="btn btn-primary">Edit</a>
    <a href="/users" class="btn btn-warning">Cancel</a>
  </div>
</div>