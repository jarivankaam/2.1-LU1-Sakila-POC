<%- include('../layout') %>

<div class="card" style="width: 18rem;">
  <img src="..." class="card-img-top" alt="...">
  <div class="card-body">
    <h5 class="card-title"><%= users.first_name %> <%= users.last_name %></h5>
    <p class="card-text">
      Some quick example text to build on the card title and make up the bulk of the card’s content.
    </p>
  </div>

  <ul class="list-group list-group-flush">
    <li class="list-group-item"><%= users.email %></li>
    <li class="list-group-item"><%= users.active %></li>
    <li class="list-group-item">A third item</li>
  </ul>

  <div class="card-body">
    <a href="/users/<%= users.customer_id %>/edit" class="btn btn-primary">Edit</a>
    <a href="/users" class="btn btn-warning">Cancel</a>
  </div>
</div>