<%- include('../layout') %>
<div class="row">
    <% films.forEach(function(film) { %>
        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mb-3">
            <div class="card h-100">
                <img src="/images/no-image-available.png" class="card-img-top" alt="Not available">
                    <div class="card-body">
                        <h5 class="card-title"><%= film.title %></h5>
                        <p class="card-text"><%= film.description %></p>
                        <a href="films/<%= film.film_id %>/details" class="btn btn-primary">Info</a>
                    </div>
            </div>
        </div>
    <% }) %>
    <div>
        <button>Add Film</button>
    </div>
</div>